{
    "name": "@student-tracker/shared",
    "version": "0.0.0",
    "main": "./index.ts",
    "types": "./index.ts",
    "scripts": {
        "build": "tsc",
        "lint": "eslint .",
        "dev": "tsc --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/node": "^20",
        "@types/react": "~18.3.0",
        "jest": "^29.7.0",
        "react": "^18.3.0",
        "ts-jest": "^29.1.4",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "axios": "^1.13.5",
        "zod": "^4.3.6"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
            "<rootDir>"
        ],
        "testMatch": [
            "**/*.test.ts"
        ],
        "collectCoverageFrom": [
            "utils/**/*.ts",
            "services/**/*.ts",
            "models/**/*.ts",
            "constants/**/*.ts",
            "validators/**/*.ts"
        ],
        "coverageThreshold": {
            "global": {
                "lines": 80
            }
        }
    }
}