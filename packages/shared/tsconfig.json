{
    "compilerOptions": {
        "target": "es2016",
        "module": "esnext",
        "moduleResolution": "node",
        "jsx": "react-jsx",
        "declaration": true,
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "./**/*.ts",
        "./__tests__/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
